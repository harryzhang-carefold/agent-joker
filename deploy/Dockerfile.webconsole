# agent-joker WebConsole — 多阶段构建（ARCH §5.2：node22 多阶段 → nginx）
#
# stage 1: node 构建 Vue3 SPA（frontend/ → dist）
# stage 2: nginx 托管 dist + 反代 /api /v1 /mcp → bff:8000（deploy/nginx/nginx.conf）
#
# 说明：
# - dist 不进 git（frontend/.gitignore），由本镜像在构建期生成，保证 compose 一键可复现。
# - 运行时不装 node（stage 2 仅 nginx:1.27-alpine，镜像小、攻击面小）。

# ---------- stage 1: 构建 ----------
FROM node:22-alpine AS build
WORKDIR /app
# 先装依赖（层缓存：package*.json 未变则不重装）
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
# 再拷源码构建
COPY frontend/ ./
RUN npm run build && test -f dist/index.html && echo "dist OK"

# ---------- stage 2: nginx 托管 ----------
FROM nginx:1.27-alpine
# 默认 nginx.conf 里 server 段替换为我们的反代配置
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
# 构建产物
COPY --from=build /app/dist /usr/share/nginx/html
# 静态资源健康检查
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
