{
  "tools": [
    {
      "name": "echo",
      "description": "回显工具：返回 x 的值（mock 默认工具）",
      "input_schema": {
        "type": "object",
        "properties": {
          "x": {"type": "string", "description": "要回显的内容"}
        },
        "required": ["x"]
      }
    },
    {
      "name": "calc",
      "description": "计算器工具：返回 a + b 的和（mock 默认工具）",
      "input_schema": {
        "type": "object",
        "properties": {
          "a": {"type": "number", "description": "第一个数"},
          "b": {"type": "number", "description": "第二个数"}
        },
        "required": ["a", "b"]
      }
    }
  ]
}
