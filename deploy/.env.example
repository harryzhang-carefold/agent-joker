# agent-joker 环境变量示例（ARCHITECTURE §5.3 全变量，不含真实密钥，DECISION-012）
# 用法：cp .env.example .env 并填写带 <...> 的项。

# --- 基础设施 ---
PG_PASSWORD=<随机密码，如 openssl rand -hex 16>
DB_DSN=postgresql+asyncpg://joker:${PG_PASSWORD}@pg:5432/joker
REDIS_URL=redis://redis:6379/0

# --- 认证（DECISION-002 / DECISION-009） ---
JWT_SECRET=<随机 64 位 hex>
INTERNAL_HMAC_SECRET=<随机 64 位 hex，与 JWT_SECRET 不同>

# --- Fernet 加密密钥（DB 凭证字段加密，DECISION-012；留空=启动随机生成） ---
FERNET_KEY=

# --- 存储（S02：配置文件可配置，后端切换=保留原后端访问；凭证 env 注入不进 DB，DECISION-012） ---
STORAGE_BACKEND=local            # local / gcs / oss（重启生效，DECISION-027）
STORAGE_LOCAL_PATH=/data/storage
GCS_BUCKET=
GCS_CREDENTIALS_PATH=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- 限流默认值（DECISION-013） ---
BFF_RATE_LIMIT_TENANT_QPS=50
BFF_RATE_LIMIT_USER_QPS=10
BFF_RATE_LIMIT_LOGIN_IP_PER_MIN=5
# 路由表路径（容器内，compose 已固化 /app/bff/routes.yml；留空=默认）
BFF_ROUTES_FILE=
# BFF 代执行 PlatformAPI 内部端点的基础地址（容器网络内）
BFF_PLATFORM_API_BASE=http://api:8001
# BFF 代理超时（秒，长文档解析/对话流式）
BFF_PROXY_TIMEOUT=120
# 限流配置 Redis 镜像缓存 TTL（秒）
BFF_RL_CACHE_TTL=10

# --- Obsidian 沉淀（DECISION-019） ---
OBSIDIAN_VAULT_PATH=/data/obsidian-vault

# --- 保留策略（D-D / DECISION-025，默认 90 天）---
# 定期清理任务每 RETENTION_CHECK_INTERVAL_HOURS 小时读一次当前配置，DROP 过期月分区
# （月分区 + DROP PARTITION，参数化非硬编码）。改天数后重启即时按新天数清理。
TRACE_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=90
RETENTION_CHECK_INTERVAL_HOURS=1

# --- LLM（S03 LLM 节点切片消费；.env 默认端点供自测闭环） ---
# 默认 chat 推理端点（OpenAI 兼容 base_url）；留空=不注册默认 endpoint（仅本地 fallback embedding）
LLM_FALLBACK_ENDPOINT=
LLM_FALLBACK_MODEL=
# 默认端点 API key（运行时 Fernet 加密落 DB，.env 只作种子来源，DECISION-012）
LLM_FALLBACK_API_KEY=
***
# 本地 fallback embedding 维度（确定性字符 n-gram 哈希，真实 embedding 端点不可用时闭环）
LLM_LOCAL_FALLBACK_DIM=256
# 连通性探测超时（秒）
LLM_PROBE_TIMEOUT_SECONDS=15

# --- 自测种子 ---
SEED_TENANT_CODE=acme
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=***
# 平台管理员（system 租户，租户管理入口；密码=SEED_ADMIN_PASSWORD）
SEED_PLATFORM_ADMIN_USERNAME=platform

# --- 日志 ---
LOG_LEVEL=INFO
